# ============================================
# 环境变量配置模板
# 复制此文件为 .env 并填写实际值
# ============================================

# ---------- 签到服务 ----------

# CoinGecko 签到配置
COINGECKO_COOKIE=your_coingecko_cookie
COINGECKO_TOKEN=your_coingecko_token

# CoinMarketCap 签到配置
COINMARKET_COOKIE=your_coinmarket_cookie
COINMARKET_TOKEN=your_coinmarket_token

# ---------- 通知服务 ----------

# 企业微信应用消息（可选）
WX_COMPANY_ID=your_company_id
WX_APP_ID=your_app_id
WX_APP_SECRET=your_app_secret

# 企业微信群机器人
BOT_KEY=your_bot_key

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# 钉钉群机器人（加签方式）
DINGTALK_ACCESS_TOKEN=your_dingtalk_access_token
DINGTALK_SECRET=your_dingtalk_secret

# ---------- LLM 锐评功能 ----------

# LLM API 配置 (支持 OpenRouter / OpenAI 等兼容格式)
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini

# ---------- 模块开关 ----------
#
# 模块开关已经搬到 config/daily.json —— 那里是默认值，改完提交即可生效，
# 而且能看到 diff、能 review、能回滚。这里不再逐个列举，避免两份清单长期漂移。
#
# 环境变量仍然可以覆盖配置文件，适合单次手动运行：
#   MODULE_REDDIT=false bun run dev      # 这一次不跑 Reddit
#   NOTIFY_TELEGRAM=false bun run dev    # 这一次不推 Telegram
#
# 命名规则：MODULE_ + 模块名的大写下划线形式（aiNews -> MODULE_AI_NEWS）
#           NOTIFY_ + 渠道名的大写下划线形式（wxBot  -> NOTIFY_WX_BOT）
# 无法识别的取值（如 MODULE_REDDIT=maybe）会被忽略，回退到配置文件的值。